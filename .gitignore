# Override global gitignore patterns that would exclude plugin content
!plugins/mise/
!plugins/mise/**

# Private-marketplace output (bds-mumise): derived artifact carrying the
# planetmodha credential — belongs in the private Directory repo, never here.
dist/

# Bytecode from assemble.sh's Python blocks importing kitlib.py (bds-jasuha).
# The blocks set sys.dont_write_bytecode too; this is the second fence, since
# the workflow commits with git add -A and a .pyc differs on every checkout.
__pycache__/
