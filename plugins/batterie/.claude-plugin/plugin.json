{
  "name": "batterie",
  "displayName": "Batterie",
  "version": "2.19.1",
  "description": "Kitchen tools for knowledge work, in one plugin: session rituals and GTD tracking (bon), Google Workspace (mise), browser automation (passe), messaging between Claude sessions (sonner), Todoist coaching (accomplis), review and isolation tools (trousse), and keeping it all current",
  "author": {
    "name": "Sameer Modha",
    "url": "https://github.com/spm1001"
  },
  "repository": "https://github.com/spm1001/batterie#readme",
  "license": "MIT",
  "keywords": [
    "gtd",
    "google-workspace",
    "browser",
    "review",
    "messaging",
    "todoist",
    "batterie"
  ],
  "skills": [
    "./suite/skills/",
    "./bon/skills/",
    "./trousse/skills/",
    "./mise/skills/",
    "./accomplis/skills/",
    "./sonner/skills/",
    "./passe/skills/"
  ],
  "types": "./suite/types/index.d.ts",
  "userConfig": {
    "kg_index_roots": {
      "type": "string",
      "title": "Knowledge graph roots (kg-index)",
      "description": "Colon-separated folders, each holding an index file (MEMORY.md, _index.md or index.md); ~ is your home. Leave blank to keep kg-index off: blank, it registers no hooks and says nothing.",
      "default": ""
    },
    "kg_index_system_prompt": {
      "type": "boolean",
      "title": "kg-index: top index in the system prompt",
      "description": "Turn off on a machine whose managed settings fence prompt changes from plugins (Claude Code then says the prompt.compose hook was skipped). Off, the top index arrives as a message just before the first prompt of each thread instead; topic indexes and subagents are unchanged.",
      "default": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/bon\" \"${CLAUDE_PLUGIN_ROOT}/bon/hooks/ensure-bon.sh\""
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/bon\" \"${CLAUDE_PLUGIN_ROOT}/bon/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/trousse\" \"${CLAUDE_PLUGIN_ROOT}/trousse/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/mise\" \"${CLAUDE_PLUGIN_ROOT}/mise/hooks/ensure-mise.sh\""
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/mise\" \"${CLAUDE_PLUGIN_ROOT}/mise/hooks/session-start.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/accomplis\" \"${CLAUDE_PLUGIN_ROOT}/accomplis/hooks/ensure-accomplis.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/sonner\" \"${CLAUDE_PLUGIN_ROOT}/sonner/hooks/ensure-sonner.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/passe\" \"${CLAUDE_PLUGIN_ROOT}/passe/hooks/ensure-passe.sh\""
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/passe\" \"${CLAUDE_PLUGIN_ROOT}/passe/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/gouteur.sh\" --pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/gouteur.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/gouteur.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_.*mise.*__do",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/gouteur.sh\""
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/bon\" \"${CLAUDE_PLUGIN_ROOT}/bon/hooks/plan-to-bon.sh\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/suite\" \"${CLAUDE_PLUGIN_ROOT}/suite/hooks/gouteur.sh\" --perm",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/bon\" \"${CLAUDE_PLUGIN_ROOT}/bon/hooks/bon-tactical.sh\""
          },
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT}/bon\" \"${CLAUDE_PLUGIN_ROOT}/bon/hooks/session-dashboard.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
