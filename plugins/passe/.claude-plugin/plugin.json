{
  "name": "passe",
  "version": "1.86.23",
  "description": "Fast browser automation via Chrome DevTools Protocol — fetch pages, screenshots, forms, network capture. Needs a Chrome running with remote debugging; the passe CLI installs itself on first session.",
  "author": {
    "name": "Sameer Modha",
    "url": "https://github.com/spm1001"
  },
  "repository": "https://github.com/spm1001/batterie#readme",
  "license": "MIT",
  "keywords": [
    "browser",
    "automation",
    "cdp",
    "chrome",
    "testing"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ensure-passe.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
